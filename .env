# Projet Efficient Frontier - Environnement de développement
# Ce fichier .env contient les variables d'environnement utilisées par Docker Compose pour configurer les services

# Contrôleur de prefix projet
COMPOSE_PROJECT_NAME=efficient_frontier

# Environnement de développement
NODE_ENV=development

# API Backend (à configurer si nécessaire)
API_URL=http://localhost:8000

# Streamlit
STREAMLIT_SERVER_PORT=8501

# Grafana (local)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_HOST_PORT=3010

# GID du groupe hôte autorisé à lire les configs monitoring (root:plugdev, mode 770)
MONITORING_GID=46

# Taux sans risque par défaut (%)
DEFAULT_RISK_FREE_RATE=2.0